# Public site https://moovicut.studio is served from the domain root.
NUXT_APP_BASE_URL=/

# Visit counter. Production mounts a Railway volume at /data.
# COUNTER_FILE wins. When it is unset, STATS_DATA_PATH is used.
# The default path is /data/visits.json.
COUNTER_FILE=/data/visits.json

# Optional. npm start (server/index.mjs) only.
# PORT=3000
# STATIC_ROOT=
# STATS_TOKEN=
