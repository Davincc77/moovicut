# Public site https://moovicut.studio is served from the domain root.
NUXT_APP_BASE_URL=/
# Demo defaults are deliberate placeholders, not working OAuth credentials.
# Replace them only after registering your own provider applications.
NUXT_PUBLIC_GOOGLE_CLIENT_ID=demo-moovicut-google-client.apps.googleusercontent.com
NUXT_PUBLIC_X_CLIENT_ID=demo-moovicut-x-client
# Browser callbacks to register for local development:
# http://localhost:3000/auth/callback
# http://127.0.0.1:3000/auth/callback
# Production callback for https://moovicut.studio :
# https://moovicut.studio/auth/callback
# Demo IDs leave Google and X buttons disabled. Replace both IDs to turn sign-in back on.
# Configure the production origin when available; never include a wildcard callback.
NUXT_PUBLIC_APP_URL=https://moovicut.studio
# A production origin used only when no browser origin is available.
NUXT_PUBLIC_PRODUCTION_ORIGIN=https://moovicut.studio
# Never put an OAuth client secret in this static app.
